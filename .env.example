# Copy to .env — loaded by legacy/contract_ai/_env.py (never overrides real env vars).
# Provider keys follow the model brand; feature knobs follow the capability.

# --- OpenAI-compatible chat (used by email_agent + contract extraction) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=            # optional

# --- Local dev via Ollama (email_agent falls back here when not on Replit) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2:3b

# --- Zhipu / GLM (contract OCR, business-card + report-photo vision, lead research) ---
ZHIPU_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GLM_MODEL=glm-4.6
GLM_VISION_MODEL=
GLM_OCR_MODEL=

# --- Feature knobs ---
AI_OUTREACH_MODEL=          # compose tasks (default gpt-5)
AI_TRIAGE_MODEL=            # classify tasks (default gpt-4.1-mini)
CONTRACT_OCR_PROVIDER=glm   # stub | glm | openai | textract
CONTRACT_EXTRACT_PROVIDER=  # openai | ollama (auto if unset)
CONTRACT_EXTRACT_MODEL=

# --- Gemini (brand_knowledge distillation) ---
GEMINI_API_KEY=
BRAND_KNOWLEDGE_MODEL=
BRAND_KNOWLEDGE_PAGES_PER_BATCH=12

# --- partnerdesk (the rewrite): one OpenAI-compatible endpoint for everything ---
# SJTU campus (campus net / VPN): https://models.sjtu.edu.cn/api/v1
#   models: deepseek-chat | deepseek-reasoner | minimax | qwen
# Ollama: http://127.0.0.1:11434/v1   GLM: https://open.bigmodel.cn/api/paas/v4/
LLM_BASE_URL=https://models.sjtu.edu.cn/api/v1
LLM_API_KEY=                  # falls back to OPENAI_API_KEY; Ollama accepts anything
LLM_MODEL=deepseek-chat
LLM_JSON_MODE=object          # schema | object; auto = schema for openai.com, object elsewhere
PO_EXTRACT_MODEL=             # optional per-task override
# --- Database (PostgreSQL only — there is no fallback engine) ---
# Required. Create the database itself once with `dev db`.
#   PARTNERDESK_DB_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@127.0.0.1:5432/partnerdesk
PARTNERDESK_DB_URL=
# Required to run the tests. Same URL shape, but point it at the SERVER: the database named
# here is only used to connect while creating and dropping a throwaway one per test.
PARTNERDESK_TEST_DB_URL=
# Pool ceiling is pool_size + max_overflow; raise both when load testing.
PARTNERDESK_POOL_SIZE=10
PARTNERDESK_MAX_OVERFLOW=20
PARTNERDESK_POOL_TIMEOUT=30
