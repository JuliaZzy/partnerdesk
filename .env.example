# Copy to .env — loaded once at startup, never overriding real env vars.
# One OpenAI-compatible endpoint covers campus, OpenAI, Ollama and GLM.
#
# Run with Docker Compose (`./dev`). Postgres lives in the stack; you do not
# start a local database, and you do not set PARTNERDESK_DB_URL here — compose
# injects the in-network URLs so a leftover localhost string cannot leak in.

# --- partnerdesk: one OpenAI-compatible endpoint for everything ---
# SJTU campus (campus net / VPN): https://models.sjtu.edu.cn/api/v1
#   models: deepseek-chat | deepseek-reasoner | minimax | qwen
# Ollama on the host: http://host.docker.internal:11434/v1
#   (127.0.0.1 inside a container is the container itself, not your Mac/PC)
# GLM: https://open.bigmodel.cn/api/paas/v4/
LLM_BASE_URL=https://models.sjtu.edu.cn/api/v1
LLM_API_KEY=                  # falls back to OPENAI_API_KEY; Ollama accepts anything
OPENAI_API_KEY=               # optional fallback when LLM_API_KEY is empty
LLM_MODEL=deepseek-chat
LLM_JSON_MODE=object          # schema | object; auto = schema for openai.com, object elsewhere
# Embeddings are a different model from LLM_MODEL. Milvus only stores the vectors.
# DashScope (text-embedding-v4, 1024 dims): https://dashscope.aliyuncs.com/compatible-mode/v1
# The key is a DashScope key, not the campus LLM key. A local OpenAI-compatible
# embedding server is the same three variables; it does not have to be a container.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
# MILVUS_URI is set by Compose (http://milvus:19530). Do not put 127.0.0.1 here.
PO_EXTRACT_MODEL=             # optional per-task override
BOCHA_API_KEY=                # web_search tool (https://open.bocha.cn)
# PDF text only. Key: https://bigmodel.cn/usercenter/proj-mgmt/apikeys (not the campus LLM key).
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/layout_parsing
SOCIALCRAWL_API_KEY=          # SocialCrawl MCP (multi-platform; https://mcp.socialcrawl.dev/mcp) → tools=
# --- Email (send_email tool) — SMTP only (QQ Mail example) ---
# QQ: Settings → Account → enable SMTP → generate 授权码 as SMTP_PASSWORD (not login pwd).
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=                    # you@qq.com
SMTP_PASSWORD=                # QQ mailbox authorization code
SMTP_FROM=                    # defaults to SMTP_USER
SMTP_USE_TLS=1                # used for port 587; port 465 uses SSL
EMAIL_DRY_RUN=                # 1 = accept without sending (local / tests)

# --- Database ---
# Compose sets PARTNERDESK_DB_URL, PARTNERDESK_TEST_DB_URL, PARTNERDESK_REDIS_URL
# and MILVUS_URI. Leave them unset in this file. The official postgres image
# creates the `partnerdesk` database. Redis is redis://redis:6379/0 on the compose network.
# Pool ceiling is pool_size + max_overflow; raise both when load testing.
PARTNERDESK_POOL_SIZE=10
PARTNERDESK_MAX_OVERFLOW=20
PARTNERDESK_POOL_TIMEOUT=30
